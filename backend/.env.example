# =============================================================
# MyStudyAI backend settings (Backend/.env) - server only.
# NEVER commit this file or share these keys.
# =============================================================

PORT=5000
NODE_ENV=development
# Web origins allowed to call the API (comma-separated; the Expo web preview is http://localhost:8081).
# The native mobile app sends no Origin header, so it is always allowed. localhost is always allowed in development.
CLIENT_URL=http://localhost:3000

# --- Supabase: Project Settings -> API ---
SUPABASE_URL=https://your-project-ref.supabase.co
# service_role / secret key - bypasses RLS, backend only, never in mobile/
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI (OpenAI) ---
AI_API_KEY=your_api_key_here
AI_MODEL=gpt-4o
AI_MAX_INPUT_CHARS=400000

# --- Uploads ---
MAX_FILE_SIZE_MB=50
