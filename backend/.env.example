# =============================================================
# MyStudyAI backend settings (Backend/.env) - server only.
# NEVER commit this file or share these keys.
# =============================================================

PORT=5000
NODE_ENV=development
# Browser origins allowed to call the API (comma-separated). localhost is always allowed in development.
CLIENT_URL=http://localhost:3000

# --- Supabase: Project Settings -> API ---
SUPABASE_URL=https://your-project-ref.supabase.co
# anon / publishable key (per-user queries run under Row Level Security)
SUPABASE_ANON_KEY=your-anon-key
# service_role / secret key - bypasses RLS, backend only, never in Frontend/
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# --- AI (Anthropic Claude) ---
AI_API_KEY=your_api_key_here
AI_MODEL=claude-opus-5
AI_USE_FALLBACKS=true
AI_MAX_INPUT_CHARS=400000

# --- Uploads ---
MAX_FILE_SIZE_MB=50
