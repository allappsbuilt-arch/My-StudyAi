# MyStudyAI backend. A phone cannot reach "localhost": use your computer's LAN IP
# (e.g. http://192.168.1.20:5000/api) or your deployed server URL.
EXPO_PUBLIC_API_URL=http://localhost:5000/api

# Optional: open straight on Home as a guest (needs "Allow anonymous sign-ins" in Supabase)
EXPO_PUBLIC_SKIP_LOGIN=false
